    kill_process "$process"
done

# 检查所有用户的 crontab
check_all_crontabs() {
    log_message "检查所有用户的 crontab..."
    for user in $(cut -f1 -d: /etc/passwd); do
        if [ -f "/var/spool/cron/crontabs/$user" ]; then
            log_message "检查用户 $user 的 crontab"
            grep -v '^#' "/var/spool/cron/crontabs/$user" | while read line; do
                # 更精确地匹配可疑模式
                if [[ "$line" =~ (curl.*\|.*sh|wget.*\|.*sh|bash.*-c|python.*http|perl.*http) ]]; then
                    log_message "发现可疑的 crontab 条目: $line"
                    # 不自动删除，仅记录
                fi
            done
        fi
    done
}

# 检查系统服务
check_systemd_services() {
    log_message "检查系统服务..."
    for service in $(systemctl list-units --type=service --state=running | grep -v "systemd\|dbus\|rsyslog" | awk '{print $1}'); do
        service_path=$(systemctl show -p FragmentPath "$service" | cut -d'=' -f2)
        if [ -f "$service_path" ]; then
            # 检查服务文件权限
            perms=$(stat -c "%a %U %G" "$service_path")
            if [[ "$perms" =~ ^[0-7][0-7][0-7]\ root\ root$ ]]; then
                log_message "服务 $service 权限正常: $perms"
            else
                log_message "警告: 服务 $service 权限异常: $perms"
            fi
        fi
    done
}

# 检查 SSH 授权文件
check_ssh_files() {
    log_message "检查 SSH 授权文件..."
    for user_home in /home/*/ /root/; do
        if [ -d "${user_home}.ssh" ]; then
            if [ -f "${user_home}.ssh/authorized_keys" ]; then
                log_message "检查 ${user_home}.ssh/authorized_keys"
                # 查找可疑的 SSH 密钥
                grep -v "^#" "${user_home}.ssh/authorized_keys" | while read line; do
                    # 只标记包含可疑命令的条目
                    if [[ "$line" =~ (command=\"curl|command=\"wget|command=\"bash.*-c) ]]; then
                        log_message "发现可疑的 SSH 密钥授权: $line"
                    fi
                done
            fi
        fi
    done
}

# 检查可疑文件而不是直接删除
check_suspicious_files() {
    log_message "检查可疑的配置文件..."
    
    # 检查可疑的 SSH 文件
    if [ -f "/root/.ssh/.authorized_keys" ]; then
        log_message "发现可疑的 SSH 授权文件: /root/.ssh/.authorized_keys（注意额外的点）"
        # 检查文件内容是否包含恶意命令
        if grep -q "command=\".*wget\|curl\|bash" "/root/.ssh/.authorized_keys"; then
            log_message "确认 /root/.ssh/.authorized_keys 包含可疑内容，已备份并删除"
            backup_file "/root/.ssh/.authorized_keys"
            rm -f "/root/.ssh/.authorized_keys"
        else
            log_message "警告: 发现 /root/.ssh/.authorized_keys 但内容似乎正常，仅备份不删除"
            backup_file "/root/.ssh/.authorized_keys"
        fi
    fi
    
    if [ -f "/root/.ssh/.known_hosts" ]; then
        log_message "发现可疑的 SSH known_hosts 文件: /root/.ssh/.known_hosts（注意额外的点）"
        backup_file "/root/.ssh/.known_hosts"
        # 记录但不删除，因为通常不会有恶意的 known_hosts
    fi
    
    if [ -f "/etc/.bashrc" ]; then
        log_message "发现可疑的 bashrc 文件: /etc/.bashrc（注意点前缀）"
        # 检查文件内容是否包含恶意命令
        if grep -q "wget\|curl\|nc -e\|bash -i" "/etc/.bashrc"; then
            log_message "确认 /etc/.bashrc 包含可疑内容，已备份并删除"
            backup_file "/etc/.bashrc"
            rm -f "/etc/.bashrc"
        else
            log_message "警告: 发现 /etc/.bashrc 但内容似乎正常，仅备份不删除"
            backup_file "/etc/.bashrc"
        fi
    fi
    
    # 检查标准位置的配置文件是否被篡改
    for file in "/etc/bashrc" "/etc/profile" "/etc/profile.d/"*; do
        if [ -f "$file" ]; then
            if grep -q "wget\|curl\|nc -e\|bash -i\|/dev/tcp/" "$file"; then
                log_message "警告: 标准配置文件 $file 包含可疑内容"
                backup_file "$file"
                # 不自动删除或修改系统文件，仅记录
            fi
        fi
    done
}

# 执行额外的检查
check_all_crontabs
check_systemd_services

# 检查 at 任务
if [ -d /var/spool/at ]; then
    log_message "检查 at 任务..."
    for job in /var/spool/at/*; do
        if [ -f "$job" ]; then
            log_message "发现 at 任务: $job"
        fi
    done
fi

# 检查 SSH 文件
check_ssh_files

# 执行可疑文件检查
check_suspicious_files

log_message "恶意软件清理脚本执行完毕。"
