#!/bin/bash

# 设置日志文件
LOG_FILE="/var/log/virus_cleanup.log"
BACKUP_DIR="/var/backup/virus_cleanup/$(date +%Y%m%d_%H%M%S)"

# 日志函数
log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOG_FILE"
}

# 权限检查
if [ "$EUID" -ne 0 ]; then
    echo "请使用 root 权限运行此脚本。" >&2
    exit 1
fi

# 检查 chattr 命令是否可用
if command -v chattr &>/dev/null; then
    CHATTR_AVAILABLE=true
else
    CHATTR_AVAILABLE=false
fi

# 移除不可变属性的辅助函数
clear_immutable() {
    local target="$1"
    if [ "$CHATTR_AVAILABLE" = true ] && [ -e "$target" ]; then
        chattr -i "$target" 2>/dev/null || log_message "警告: 无法去除 $target 的不可变属性"
    fi
}

# 创建备份目录
mkdir -p "$BACKUP_DIR"

if [ "$CHATTR_AVAILABLE" = false ]; then
    log_message "警告: 未找到 chattr 命令，将跳过不可变属性恢复操作"
fi

# 备份文件函数
backup_file() {
    local file="$1"
    if [ -f "$file" ] || [ -d "$file" ]; then
        cp -r "$file" "$BACKUP_DIR/"
        log_message "已备份文件: $file 到 $BACKUP_DIR"
    fi
}

is_malicious_preload_entry() {
    case "$1" in
        */libprocesshider.so|*/libcryptocoin.so|*/libloading.so|*/libsystemd.so|*/libtcs.so|*/libcset.so|*/top.so|*/masscan.so|*/pnscan.so|*/httpd.so|*/bioset.so|*/libsmoker.so)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

clean_ld_so_preload() {
    local preload_file="/etc/ld.so.preload"
    local tmp_file
    local removed=false

    if [ ! -f "$preload_file" ]; then
        log_message "$preload_file 文件不存在，跳过内容检查"
        return
    fi

    log_message "检查 $preload_file 内容:"
    tee -a "$LOG_FILE" < "$preload_file"
    backup_file "$preload_file"
    clear_immutable "$preload_file"

    tmp_file=$(mktemp) || {
        log_message "错误: 无法创建临时文件，跳过 $preload_file 清理"
        return 1
    }

    while IFS= read -r line || [ -n "$line" ]; do
        if is_malicious_preload_entry "$line"; then
            log_message "移除已知恶意 preload 条目: $line"
            removed=true
            continue
        fi
        printf '%s\n' "$line" >> "$tmp_file"
    done < "$preload_file"

    if [ "$removed" = true ]; then
        cat "$tmp_file" > "$preload_file"
        log_message "$preload_file 已移除已知恶意条目"
    else
        log_message "$preload_file 未发现已知恶意条目，保持原样"
    fi

    rm -f "$tmp_file"
}

# 查看 /etc/ld.so.preload 内容
clean_ld_so_preload

