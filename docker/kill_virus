for file in "${files_to_remove[@]}"; do
    if [ -f "$file" ] || [ -d "$file" ]; then
        backup_file "$file"
        clear_immutable "$file"
        rm -rf "$file"
        log_message "$file 已删除"
    fi
done

# 改进的进程终止函数
kill_process() {
    local process="$1"
    
    # 检查是否是路径
    if [[ "$process" == /* ]]; then
        # 使用完整路径进行精确匹配
        local pids=""
        local exe
        for exe in /proc/[0-9]*/exe; do
            [ -e "$exe" ] || continue
            local pid="${exe#/proc/}"
            pid="${pid%/exe}"
            local proc_path
            proc_path=$(readlink -f "$exe" 2>/dev/null)
            if [ "$proc_path" = "$process" ]; then
                pids="$pids $pid"
            fi
        done
        if [ ! -z "$pids" ]; then
            for pid in $pids; do
                kill -9 "$pid"
                log_message "进程 $process (PID: $pid) 已终止"
            done
        fi
    else
        # 对于非路径的进程名，使用更多检查来避免误杀
        # 1. 检查确切的命令名称匹配
        # 2. 只终止可疑的进程（如 CPU 使用率高，非系统进程）
        local pids=""
        local proc_dir
        for proc_dir in /proc/[0-9]*; do
            [ -d "$proc_dir" ] || continue
            local pid="${proc_dir#/proc/}"
            local proc_name
            proc_name=$(cat "$proc_dir/comm" 2>/dev/null)
            if [ "$proc_name" = "$process" ]; then
                pids="$pids $pid"
            fi
        done
        if [ ! -z "$pids" ]; then
            for pid in $pids; do
                # 额外检查进程名
                local proc_name=$(cat /proc/$pid/comm 2>/dev/null)
                local cmdline=$(cat /proc/$pid/cmdline 2>/dev/null | tr '\0' ' ')
                local proc_user=$(ps -p "$pid" -o user= 2>/dev/null | awk '{print $1}')
                local cpu_high=$(ps -p "$pid" -o pcpu= 2>/dev/null | awk '{print ($1 > 50.0) ? "true" : "false"}')
                
                # 检查是否是已知的合法系统进程
                if [[ "$proc_name" != "systemd" && "$proc_name" != "init" && 
                     "$proc_name" != "kthreadd" && "$proc_name" != "sshd" && 
                     "$proc_name" != "bash" && "$proc_name" != "sh" && 
                     ! "$cmdline" =~ ^/(usr|bin)/(bash|sh) ]]; then
                    
                    # 记录可疑进程详细信息
                    log_message "发现可疑进程: $proc_name (PID: $pid, cmdline: $cmdline)"
                    
                    # 仅当进程名精确匹配时才终止
                    if [[ "$proc_name" == "$process" && ( "$cpu_high" == "true" || "$proc_user" != "root" && "$proc_user" != "nobody" && "$proc_user" != "www-data" ) ]]; then
                        kill -9 "$pid"
                        log_message "已终止可疑进程: $proc_name (PID: $pid)"
                    fi
                fi
            done
        fi
    fi
}

# 杀掉指定进程，使用完整路径可以更精确地匹配
